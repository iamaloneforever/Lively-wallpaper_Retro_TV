<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Branding.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>4.0.0</Version>
    <Win32Resource>Assets/SpicyBond.res</Win32Resource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SpicyBond.Setup/WindowsSetup.cs" Link="Setup/WindowsSetup.cs" />
    <Compile Include="../SpicyBond.Setup/SetupWindow.cs" Link="Setup/SetupWindow.cs" />
    <Compile Include="../SpicyBond.Setup/InstallationFiles.cs" Link="Setup/InstallationFiles.cs" />
    <EmbeddedResource Include="../../../lively/LivelyInfo.json" LogicalName="LivelyInfo.json" />
    <EmbeddedResource Include="$(LicenseBundlePath)" LogicalName="SpicyBond.Licenses.zip" Condition="'$(LicenseBundlePath)' != '' And Exists('$(LicenseBundlePath)')" />
    <Resource Include="Assets/SpicyBond.ico" />
  </ItemGroup>
  <Target Name="RequireDistributionLicenses" BeforeTargets="PrepareForBuild" Condition="'$(RequireLicenseBundle)' == 'true'">
    <Error Condition="'$(LicenseBundlePath)' == '' Or !Exists('$(LicenseBundlePath)')" Text="Generate and embed the Windows license bundle before publishing." />
  </Target>
</Project>
