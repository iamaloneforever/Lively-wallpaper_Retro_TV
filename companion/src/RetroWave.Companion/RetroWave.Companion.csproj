<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RetroWave</AssemblyName>
    <Version>4.0.0</Version>
    <Product>RetroWave TV</Product>
    <Title>RetroWave</Title>
    <Description>RetroWave — Music Companion for Lively Wallpaper</Description>
    <Company>RetroWave TV contributors</Company>
    <Copyright>Copyright © 2026 RetroWave TV contributors</Copyright>
    <Win32Resource>Assets/RetroWave.res</Win32Resource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RetroWave.Setup/WindowsSetup.cs" Link="Setup/WindowsSetup.cs" />
    <Compile Include="../RetroWave.Setup/SetupWindow.cs" Link="Setup/SetupWindow.cs" />
    <Compile Include="../RetroWave.Setup/InstallationFiles.cs" Link="Setup/InstallationFiles.cs" />
    <EmbeddedResource Include="../../../lively/LivelyInfo.json" LogicalName="LivelyInfo.json" />
    <EmbeddedResource Include="$(LicenseBundlePath)" LogicalName="RetroWave.Licenses.zip" Condition="'$(LicenseBundlePath)' != '' And Exists('$(LicenseBundlePath)')" />
    <Resource Include="Assets/RetroWave.ico" />
  </ItemGroup>
  <Target Name="RequireDistributionLicenses" BeforeTargets="PrepareForBuild" Condition="'$(RequireLicenseBundle)' == 'true'">
    <Error Condition="'$(LicenseBundlePath)' == '' Or !Exists('$(LicenseBundlePath)')" Text="Generate and embed the Windows license bundle before publishing." />
  </Target>
</Project>
