<Window x:Class="RetroWave.Companion.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroWave" Width="1100" Height="760" MinWidth="760" MinHeight="560" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" ThemeMode="System" Icon="Assets/RetroWave.ico">
    <Window.Resources>
        <!-- Keep Fluent's native control templates, focus, pressed and disabled states. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid><Border x:Name="Surface" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource NavigationAccent}" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource NavigationHover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource NavigationSelected}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppText}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/><Setter Property="Background" Value="{DynamicResource CardBackground}"/></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,22,0">
            <StackPanel DockPanel.Dock="Top" Margin="12,10,0,28"><Image x:Name="BrandMark" Width="48" Height="48" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="RetroWave" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Music companion" Opacity="0.65"/></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="8"><TextBlock x:Name="BridgeLabel" Text="Connecting…"/><TextBlock Text="RetroWave TV · 4.0" Opacity="0.6" FontSize="12"/></StackPanel>
            <ListBox x:Name="Navigation" SelectionChanged="Navigate" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AppText}" SelectedIndex="0" FontSize="15">
                <ListBoxItem Tag="Dashboard"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,4,12,4"/><TextBlock Text="Dashboard"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="Now Playing"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,4,12,4"/><TextBlock Text="Now Playing"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="Music Finder"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,4,12,4"/><TextBlock Text="Music Finder"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,4,12,4"/><TextBlock Text="Settings"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="Diagnostics"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,4,12,4"/><TextBlock Text="Diagnostics"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="About"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,4,12,4"/><TextBlock Text="About"/></StackPanel></ListBoxItem>
            </ListBox>
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,12,0">
            <StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource Heading}"/><StackPanel x:Name="PageContent"/></StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
