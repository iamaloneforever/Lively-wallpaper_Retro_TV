{
  "name": "retrowave-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-spicy.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/build-spicy.mjs && tsc --noEmit && vite build && node scripts/check-web.mjs",
    "test:packaging": "node --test scripts/tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.16.0",
    "cubic-spline": "3.0.3",
    "d3-ease": "3.0.1",
    "simplebar": "6.3.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.19.0"
}
